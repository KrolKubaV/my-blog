---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS } from '../../config';
import { getCollection } from 'astro:content';

const section = SECTIONS['puzzles'];
const subsection = section.subsections.find(s => s.slug === 'project-euler');

const posts = (await getCollection('puzzles'))
  .filter(p => !p.data.draft && p.data.subsection === 'project-euler')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Project Euler">
  <p class="breadcrumb"><a href="/puzzles/">← Puzzles</a></p>
  <h1>Project Euler</h1>

  <p>I enjoy working on <a href="https://projecteuler.net" target="_blank">Project Euler</a> problems — my goal is to eventually solve all of them.</p>

  <a href="https://projecteuler.net/progress/KrolKubaV" target="_blank" class="profile-link">
    <img src="https://projecteuler.net/avatars/KrolKubaV.jpg" alt="KrolKubaV" class="avatar" />
    <div>
      <span class="profile-label">My Progress</span>
      <span class="profile-username">KrolKubaV on Project Euler →</span>
    </div>
  </a>

  {posts.length > 0 && (
    <div class="problems">
      <h2>Solved Problems</h2>
      <ul>
        {posts.map(post => (
          <li>
            <a href={`/puzzles/read/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </div>
  )}
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .profile-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .profile-link:hover {
    border-color: #1e3a5f;
    box-shadow: 0 2px 8px rgba(30, 58, 95, 0.08);
    text-decoration: none;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid #e5e7eb;
  }
  .profile-label {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    color: #111827;
  }
  .profile-username {
    display: block;
    font-size: 0.85rem;
    color: #6b7280;
  }
  .profile-link:hover .profile-label {
    color: #1e3a5f;
  }
  .problems {
    margin-top: 2.5rem;
  }
  .problems h2 {
    font-size: 1.2rem;
  }
  .problems ul {
    list-style: none;
    padding: 0;
  }
  .problems li {
    border-bottom: 1px solid #f3f4f6;
  }
  .problems li:last-child {
    border-bottom: none;
  }
  .problems a {
    display: block;
    padding: 0.85rem 0;
    font-weight: 700;
    color: #111827;
    transition: color 0.2s, padding-left 0.2s ease;
  }
  .problems a:hover {
    color: #1e3a5f;
    padding-left: 0.4rem;
    text-decoration: none;
  }
</style>
