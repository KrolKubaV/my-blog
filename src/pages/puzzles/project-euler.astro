---
import BaseLayout from '../../layouts/BaseLayout.astro';
const PROBLEMS_TOTAL = 1007;
---
<BaseLayout title="Project Euler">
  <p class="breadcrumb"><a href="/puzzles/">← Puzzles</a></p>
  <h1>Project Euler</h1>

  <p>I enjoy working on <a href="https://projecteuler.net" target="_blank">Project Euler</a> problems — my goal is to eventually solve all of them.</p>

  <div class="profile">
    <img src="https://projecteuler.net/profile/KrolKubaV.png" alt="Project Euler Progress" class="progress-img" />
  </div>

  <div class="stats">
    <div class="stat-header">
      <span class="stat-label">Solved</span>
      <span class="stat-count" id="solved-count">— / {PROBLEMS_TOTAL}</span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" id="progress-fill"></div>
    </div>
  </div>

  <div class="map">
    <h2>Problem Map</h2>
    <img src="https://projecteuler.net/progress/KrolKubaV" alt="Problem map" class="map-img" />
  </div>

  <script is:inline define:vars={{ PROBLEMS_TOTAL }}>
    fetch('https://projecteuler.net/profile/KrolKubaV.png')
      .then(() => {
        const badge = document.querySelector('.progress-img');
        if (badge) {
          badge.onload = function() {
            const canvas = document.createElement('canvas');
            canvas.width = badge.naturalWidth;
            canvas.height = badge.naturalHeight;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(badge, 0, 0);
            const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
            let solved = 0;
            for (let i = 0; i < data.length; i += 4) {
              if (data[i + 3] > 128 && !(data[i] > 240 && data[i + 1] > 240 && data[i + 2] > 240)) {
                solved++;
              }
            }
            const pct = Math.min(Math.round((solved / 500) * 100), PROBLEMS_TOTAL);
            document.getElementById('solved-count').textContent = pct + ' / ' + PROBLEMS_TOTAL;
            document.getElementById('progress-fill').style.width = (pct / PROBLEMS_TOTAL * 100) + '%';
          };
        }
      })
      .catch(() => {});
  </script>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .profile {
    text-align: center;
    margin-top: 2rem;
  }
  .progress-img {
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .stats {
    margin-top: 1.5rem;
  }
  .stat-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .stat-label {
    font-weight: 700;
    font-size: 1rem;
    color: #111827;
  }
  .stat-count {
    font-size: 0.9rem;
    color: #6b7280;
  }
  .progress-bar {
    width: 100%;
    height: 8px;
    background: #f3f4f6;
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: #1e3a5f;
    border-radius: 4px;
    transition: width 1s ease;
  }

  .map {
    margin-top: 2.5rem;
  }
  .map h2 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .map-img {
    max-width: 100%;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
  }
</style>
