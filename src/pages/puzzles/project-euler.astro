---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Project Euler">
  <p class="breadcrumb"><a href="/puzzles/">← Puzzles</a></p>
  <h1>Project Euler</h1>

  <p>I enjoy working on <a href="https://projecteuler.net" target="_blank">Project Euler</a> problems — my goal is to eventually solve all of them.</p>

  <div class="profile">
    <img src="https://projecteuler.net/profile/KrolKubaV.png" alt="Project Euler Progress" />
  </div>

  <div class="map">
    <img src="https://projecteuler.net/progress/KrolKubaV" alt="Problem map" />
  </div>

  <p class="note"><a href="https://projecteuler.net/progress/KrolKubaV" target="_blank">View full progress on Project Euler →</a></p>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .profile {
    text-align: center;
    margin: 2rem 0;
  }
  .profile img {
    image-rendering: pixelated;
  }
  .map {
    text-align: center;
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
  }
  .map img {
    max-width: 100%;
  }
  .note {
    text-align: center;
    font-size: 0.9rem;
    color: #6b7280;
    margin-top: 1.5rem;
  }
</style>
