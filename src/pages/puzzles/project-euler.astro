---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { solvedProblems, PROJECT_EULER_PROBLEMS_TOTAL } from '../../data/project-euler';

const solvedCount = Object.keys(solvedProblems).length;
const pct = Math.round((solvedCount / PROJECT_EULER_PROBLEMS_TOTAL) * 100);

const allProblems = Array.from({ length: PROJECT_EULER_PROBLEMS_TOTAL }, (_, i) => i + 1);
const cols = 25;
const rows = Math.ceil(PROJECT_EULER_PROBLEMS_TOTAL / cols);
---
<BaseLayout title="Project Euler">
  <p class="breadcrumb"><a href="/puzzles/">← Puzzles</a></p>
  <h1>Project Euler</h1>

  <p><a href="https://projecteuler.net" target="_blank">Project Euler</a> is a series of challenging mathematical and computational problems that require both mathematical insight and programming skill. I enjoy digging into them — my dream is to one day have every single problem solved.</p>

  <div class="stats">
    <div class="stat-header">
      <span class="stat-label">Solved</span>
      <span class="stat-count">{solvedCount} / {PROJECT_EULER_PROBLEMS_TOTAL} ({pct}%)</span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" style={`width: ${pct}%`}></div>
    </div>
  </div>

  <div class="map">
    <div class="grid" style={`grid-template-columns: repeat(${cols}, 1fr)`}>
      {allProblems.map(id => (
        <span
          class={id in solvedProblems ? 'cell solved' : 'cell unsolved'}
          title={id in solvedProblems ? `Problem ${id}: Solved ${solvedProblems[id]}` : `Problem ${id}: Unsolved`}
        ></span>
      ))}
    </div>
  </div>

  <div class="profile-wrap">
    <img src="https://projecteuler.net/profile/KrolKubaV.png" alt="KrolKubaV's Project Euler progress" />
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .stats {
    margin: 2rem 0 1.5rem;
  }
  .stat-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .stat-label {
    font-weight: 700;
    font-size: 1rem;
    color: #111827;
  }
  .stat-count {
    font-size: 0.9rem;
    color: #6b7280;
  }
  .progress-bar {
    width: 100%;
    height: 10px;
    background: #f3f4f6;
    border-radius: 5px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: #1e3a5f;
    border-radius: 5px;
    transition: width 1s ease;
  }
  .map {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
  }
  .grid {
    display: grid;
    gap: 2px;
  }
  .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    min-width: 4px;
  }
  .solved {
    background: #1e3a5f;
  }
  .unsolved {
    background: #f3f4f6;
  }
  .profile-wrap {
    margin: 2.5rem 0;
    text-align: center;
  }
  .profile-wrap img {
    display: block;
    margin: 0 auto;
    image-rendering: pixelated;
  }
</style>
