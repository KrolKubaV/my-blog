---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Project Euler">
  <p class="breadcrumb"><a href="/puzzles/">← Puzzles</a></p>
  <h1>Project Euler</h1>

  <p>I enjoy working on <a href="https://projecteuler.net" target="_blank">Project Euler</a> problems — my goal is to eventually solve all of them.</p>

  <div class="progress-card">
    <img src="https://projecteuler.net/profile/KrolKubaV.png" alt="Project Euler Progress" class="progress-img" />
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .progress-card {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    display: inline-block;
  }
  .progress-img {
    max-width: 100%;
    height: auto;
  }
</style>
