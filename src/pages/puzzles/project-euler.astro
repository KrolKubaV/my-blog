---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { solvedProblems, PROJECT_EULER_PROBLEMS_TOTAL } from '../../data/project-euler';

const solvedCount = Object.keys(solvedProblems).length;
const pct = Math.round((solvedCount / PROJECT_EULER_PROBLEMS_TOTAL) * 100);

const blockSize = 100;
const numBlocks = Math.ceil(PROJECT_EULER_PROBLEMS_TOTAL / blockSize);
const blocks = Array.from({ length: numBlocks }, (_, b) => {
  const start = b * blockSize + 1;
  const end = Math.min((b + 1) * blockSize, PROJECT_EULER_PROBLEMS_TOTAL);
  return Array.from({ length: end - start + 1 }, (_, i) => start + i);
});
---
<BaseLayout title="Project Euler">
  <p class="breadcrumb"><a href="/puzzles/">← Puzzles</a></p>
  <h1>Project Euler</h1>

  <div class="profile-wrap">
    <img src="https://projecteuler.net/profile/KrolKubaV.png" alt="KrolKubaV's Project Euler progress" />
  </div>

  <p><a href="https://projecteuler.net" target="_blank">Project Euler</a> is a series of challenging mathematical and computational problems that require both mathematical insight and programming skill. I enjoy digging into them — my dream is to one day have every single problem solved.</p>

  <div class="stats">
    <div class="stat-header">
      <span class="stat-label">Solved</span>
      <span class="stat-count">{solvedCount} / {PROJECT_EULER_PROBLEMS_TOTAL} ({pct}%)</span>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" style={`width: ${pct}%`}></div>
    </div>
  </div>

  <div class="blocks">
    {blocks.map(block => (
      <div class="block">
        <span class="block-label">{block[0]}–{block[block.length - 1]}</span>
        <div class="grid">
          {block.map(id => (
            <span class={`cell ${id in solvedProblems ? 'solved' : 'unsolved'}`}>
              {id % 100}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .profile-wrap {
    margin: 2rem 0 1.5rem;
    text-align: center;
  }
  .profile-wrap img {
    display: block;
    margin: 0 auto;
    image-rendering: pixelated;
  }
  .stats {
    margin: 2rem 0 1.5rem;
  }
  .stat-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .stat-label {
    font-weight: 700;
    font-size: 1rem;
    color: #111827;
  }
  .stat-count {
    font-size: 0.9rem;
    color: #6b7280;
  }
  .progress-bar {
    width: 100%;
    height: 10px;
    background: #f3f4f6;
    border-radius: 5px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: #1e3a5f;
    border-radius: 5px;
    transition: width 1s ease;
  }
  .blocks {
    margin: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .block {
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 0.35rem 0.5rem 0.5rem;
    flex: 0 0 auto;
  }
  .block-label {
    display: block;
    text-align: center;
    font-size: 0.65rem;
    color: #9ca3af;
    margin-bottom: 0.25rem;
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 1px;
  }
  .cell {
    aspect-ratio: 1;
    border-radius: 1px;
    font-size: 0.55rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 10px;
  }
  .solved {
    background: #1e3a5f;
    color: rgba(255,255,255,0.9);
  }
  .unsolved {
    background: #f3f4f6;
    color: transparent;
  }
  .cell:hover {
    opacity: 0.7;
  }
</style>
