---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostItem from '../../../components/PostItem.astro';
import { getCollection } from 'astro:content';

const subcategories = [
  { label: 'IMO', slug: 'imo' },
  { label: 'Polish Olympiad', slug: 'polish-olympiad' },
];

const allPosts = (await getCollection('puzzles'))
  .filter(p => !p.data.draft && p.data.subsection === 'mathematical-competitions')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const grouped = subcategories.map(sub => ({
  label: sub.label,
  slug: sub.slug,
  posts: allPosts.filter(p => p.data.subcategory === sub.slug),
}));
---

<BaseLayout title="Mathematical Competitions">
  <p><a href="/puzzles/">← Puzzles</a></p>
  <h1>Mathematical Competitions</h1>

  {grouped.map(group => (
    <section>
      <h2>{group.label}</h2>
      {group.posts.length > 0 ? (
        <ul>
          {group.posts.map(post => (
            <PostItem
              title={post.data.title}
              slug={`/puzzles/read/${post.id}`}
            />
          ))}
        </ul>
      ) : (
        <p>No posts yet.</p>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  section {
    margin-top: 2rem;
  }
  h2 {
    font-size: 1.2rem;
    color: #111827;
    margin-bottom: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
