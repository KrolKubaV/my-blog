---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SECTIONS } from '../../../config';

const section = SECTIONS['puzzles'];
const subsection = section.subsections.find(s => s.slug === 'mathematical-competitions');
const subcategories = [
  { label: 'IMO', slug: 'imo', description: 'Problems from the International Mathematical Olympiad.' },
  { label: 'Polish Olympiad', slug: 'polish-olympiad', description: 'Problems from the Polish Mathematical Olympiad.' },
];
---

<BaseLayout title={subsection!.label}>
  <p><a href="/puzzles/">← Puzzles</a></p>
  <h1>{subsection!.label}</h1>

  <ul class="section-list">
    {subcategories.map(sub => (
      <li>
        <a href={`/puzzles/mathematical-competitions/${sub.slug}/`}>{sub.label}</a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .section-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .section-list li {
    border-bottom: 1px solid #f3f4f6;
  }
  .section-list li:last-child {
    border-bottom: none;
  }
  .section-list a {
    display: block;
    padding: 0.85rem 0;
    text-decoration: none;
    color: inherit;
    font-weight: 700;
    font-size: 1.1rem;
    color: #111827;
    transition: color 0.2s, padding-left 0.2s ease;
  }
  .section-list a:hover {
    color: #0d5e63;
    padding-left: 0.4rem;
    text-decoration: none;
  }
</style>
