---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostItem from '../../../components/PostItem.astro';
import { getCollection } from 'astro:content';
import { postRank } from '../../../config';

export async function getStaticPaths() {
  const posts = await getCollection('puzzles');
  const subsections = ['mathematical-competitions'];
  const subcategories = ['imo', 'polish-olympiad'];
  const paths = [];
  for (const subcategory of subcategories) {
    const label = subcategory === 'imo' ? 'IMO' : 'Polish Olympiad';
    paths.push({
      params: { subcategory },
      props: { subcategory, label },
    });
  }
  return paths;
}

const { subcategory, label } = Astro.props;
const posts = (await getCollection('puzzles'))
  .filter(p => !p.data.draft
    && p.data.subsection === 'mathematical-competitions'
    && p.data.subcategory === subcategory)
  .sort((a, b) => postRank('puzzles/mathematical-competitions', a.id) - postRank('puzzles/mathematical-competitions', b.id) || (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
---

<BaseLayout title={label}>
  <p><a href="/puzzles/mathematical-competitions/">← Mathematical Competitions</a></p>
  <h1>{label}</h1>

  {posts.length > 0 ? (
    <ul>
      {posts.map(post => (
        <PostItem
          title={post.data.title}
          slug={`/puzzles/read/${post.id}`}
        />
      ))}
    </ul>
  ) : (
    <p>No posts yet.</p>
  )}
</BaseLayout>
