---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrevNext from '../../../components/PrevNext.astro';
import Toc from '../../../components/Toc.astro';
import { getCollection, render } from 'astro:content';
import { SECTIONS } from '../../../config';
import { orderedPosts, neighbours } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('puzzles');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const section = SECTIONS['puzzles'];
const subsection = section.subsections.find(s => s.slug === post.data.subsection);
const siblings = await orderedPosts('puzzles', `puzzles/${post.data.subsection}`, post.data.subsection);
const { prev, next } = neighbours(siblings, post.id);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <p class="breadcrumb">
    <a href="/puzzles/">← Puzzles</a>
    {subsection && <> · <a href={`/puzzles/${subsection.slug}/`}>{subsection.label}</a></>}
  </p>
  <h1>{post.data.title}</h1>
  <article>
    <Content />
  </article>
  <PrevNext
    prev={prev && { title: prev.data.title, href: `/puzzles/read/${prev.id}/` }}
    next={next && { title: next.data.title, href: `/puzzles/read/${next.id}/` }}
  />
  <Toc />
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
</style>
