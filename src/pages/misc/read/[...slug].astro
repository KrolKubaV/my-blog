---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrevNext from '../../../components/PrevNext.astro';
import Toc from '../../../components/Toc.astro';
import { getCollection, render } from 'astro:content';
import { orderedPosts, neighbours } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('misc');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siblings = await orderedPosts('misc', 'misc');
const { prev, next } = neighbours(siblings, post.id);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <p class="breadcrumb"><a href="/misc/">← Miscellaneous</a></p>
  <h1>{post.data.title}</h1>
  <article>
    <Content />
  </article>
  <PrevNext
    prev={prev && { title: prev.data.title, href: `/misc/read/${prev.id}/` }}
    next={next && { title: next.data.title, href: `/misc/read/${next.id}/` }}
  />
  <Toc />
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
  }
</style>
