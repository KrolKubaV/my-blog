---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <h1>Hi, I'm Jakub.</h1>
    <p>
      I write about mathematics, probability, casino games, puzzles, and other
      things that interest me.
    </p>
  </section>
</BaseLayout>

<style>
  /* Everything on the homepage is one size, like the article text. */
  .hero {
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .hero h1 {
    font-size: inherit;
    line-height: inherit;
  }
</style>
