---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS } from '../../config';

const section = SECTIONS['notes'];
---
<BaseLayout title="Notes">
  <h1>Notes</h1>

  <ul class="section-list">
    {section.subsections.map(sub => (
      <li>
        <a href={`/my-blog/notes/${sub.slug}/`}>{sub.label}</a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .section-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .section-list li {
    border-bottom: 1px solid #f3f4f6;
  }
  .section-list li:last-child {
    border-bottom: none;
  }
  .section-list a {
    display: block;
    padding: 0.85rem 0;
    text-decoration: none;
    color: inherit;
    font-weight: 700;
    font-size: 1.1rem;
    color: #111827;
    transition: color 0.2s, padding-left 0.2s ease;
  }
  .section-list a:hover {
    color: #1e3a5f;
    padding-left: 0.4rem;
    text-decoration: none;
  }
</style>
