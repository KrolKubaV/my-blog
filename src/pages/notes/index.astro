---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS } from '../../config';

const section = SECTIONS['notes'];
---
<BaseLayout title="Notes">
  <h1>Notes</h1>

  <div class="section-list">
    {section.subsections.map(sub => (
      <a href={`/my-blog/notes/${sub.slug}/`} class="section-card">
        <h2>{sub.label}</h2>
        <p>{sub.description}</p>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .section-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .section-card {
    display: block;
    padding: 1rem 1.25rem;
    margin: 0 -1.25rem;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .section-card:hover {
    background: #f9fafb;
    text-decoration: none;
  }
  .section-card h2 {
    margin: 0;
    font-size: 1.25rem;
    transition: color 0.15s;
  }
  .section-card:hover h2 {
    color: #1e3a5f;
  }
  .section-card p {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: #6b7280;
  }
</style>
