---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INTROS } from '../../config';
import { getTopics } from '../../lib/posts';

const topics = await getTopics();
---
<BaseLayout title="Notes" description={INTROS.notes}>
  <h1 class="page-title">Notes</h1>
  <p class="page-intro">{INTROS.notes}</p>

  <ul class="post-list topics">
    {topics.map(topic => (
      <li>
        <a href={`/notes/${topic.slug}/`} class="post-link">
          <span class="main">
            <span class="title">{topic.label}</span>
            {topic.description && <span class="desc">{topic.description}</span>}
          </span>
          <span class="count">{topic.notes.length} {topic.notes.length === 1 ? 'note' : 'notes'}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .topics {
    margin-top: 2rem;
  }
  .count {
    flex: none;
    font-size: 0.9rem;
    color: var(--faint);
  }
  .post-link:hover .count {
    color: var(--accent);
  }
</style>
