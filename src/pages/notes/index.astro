---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INTROS, SHOW } from '../../config';
import { getTopics, postUrl } from '../../lib/posts';

const topics = await getTopics();
---
<BaseLayout title="Notes" description={INTROS.notes}>
  <h1 class="page-title">Notes</h1>
  {SHOW.sectionIntros && <p class="page-intro">{INTROS.notes}</p>}

  <ul class="post-list topics">
    {topics.map(topic => (
      <li>
        <a href={postUrl(topic.notes[0])} class="post-link">
          <span class="title">{topic.label}</span>
          {SHOW.topicDescriptions && topic.description && <span class="desc">{topic.description}</span>}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .topics {
    margin-top: 2rem;
  }
</style>
