---
// /notes/<topic>/ opens the topic's first note; the sidebar there lists the rest.
import { getTopics, postUrl } from '../../../lib/posts';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map(topic => ({ params: { topic: topic.slug }, props: { first: postUrl(topic.notes[0]) } }));
}

return Astro.redirect(Astro.props.first);
---
