---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SECTIONS } from '../../config';

const section = SECTIONS['casino-games'];
---
<BaseLayout title="Casino Games">
  <h1>Casino Games</h1>

  {section.subsections.length > 0 ? (
    <ul>
      {section.subsections.map(sub => (
        <li><a href={`/casino-games/${sub.slug}/`}>{sub.label}</a></li>
      ))}
    </ul>
  ) : (
    <p style="color: var(--color-muted);">No subsections yet.</p>
  )}
</BaseLayout>
