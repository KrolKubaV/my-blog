---
// Compact Project Euler progress, linking to the full page.
import { getEulerStats } from '../lib/project-euler.mjs';

const pe = await getEulerStats();
const latest = pe.recent[0];
---
<a href="/puzzles/project-euler/" class="card euler">
  <p class="kicker">Project Euler</p>
  <p class="count"><strong>{pe.count}</strong> <span>/ {pe.total} solved</span></p>
  <div class="progress" role="progressbar" aria-valuenow={pe.count} aria-valuemin="0" aria-valuemax={pe.total}>
    <span style={`width: ${(pe.count / pe.total) * 100}%`}></span>
  </div>
  <p class="foot">
    <span>{pe.percent}% complete</span>
    {latest && <span>Latest: #{latest}</span>}
  </p>
</a>

<style>
  .euler {
    padding: 1.15rem 1.25rem;
  }
  .kicker {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }
  .count {
    margin: 0.15rem 0 0.9rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .count strong {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--heading);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--faint);
  }
</style>
