---
// Problems solved over time: one cumulative step line. Drawn at build time;
// the small script only adds the hover read-out.
import type { Solve } from '../lib/project-euler';
import { formatDate } from '../lib/posts';

interface Props {
  solves: Solve[]; // any order
}

const solves = [...Astro.props.solves].sort((a, b) => a.date.valueOf() - b.date.valueOf());
const first = solves[0].date;
const t0 = Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), 1);
const t1 = Math.max(Date.now(), solves.at(-1)!.date.valueOf());
const yMax = Math.ceil(solves.length / 50) * 50;

// The SVG is 1000 × 100 units, stretched to fit; labels are HTML on top.
const x = (t: number) => ((t - t0) / (t1 - t0)) * 1000;
const y = (n: number) => 100 - (n / yMax) * 100;

let line = `M0 ${y(0)}`;
solves.forEach((s, i) => (line += ` H${x(s.date.valueOf()).toFixed(2)} V${y(i + 1).toFixed(2)}`));
line += ' H1000';
const area = `${line} V100 H0 Z`;

const yTicks = Array.from({ length: yMax / 50 + 1 }, (_, i) => i * 50);
const xTicks: { t: number; label: string }[] = [];
for (let year = new Date(t0).getUTCFullYear() + 1; Date.UTC(year, 0, 1) < t1; year++) {
  xTicks.push({ t: Date.UTC(year, 0, 1), label: String(year) });
}

const points = solves.map((s, i) => [s.date.valueOf(), i + 1, s.id]);
const summary = `${solves.length} problems solved between ${formatDate(first)} and ${formatDate(solves.at(-1)!.date)}.`;
---
<figure class="chart">
  <figcaption>Problems solved over time</figcaption>
  <div
    class="plot"
    data-points={JSON.stringify(points)}
    data-t0={t0}
    data-t1={t1}
    data-ymax={yMax}
    tabindex="0"
    role="img"
    aria-label={summary}
  >
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
      {yTicks.map(n => <line class="grid" x1="0" x2="1000" y1={y(n)} y2={y(n)} />)}
      <path class="area" d={area} />
      <path class="line" d={line} />
    </svg>
    {yTicks.map(n => <span class="ytick" style={`top: ${y(n)}%`}>{n}</span>)}
    {xTicks.map(tick => <span class="xtick" style={`left: ${x(tick.t) / 10}%`}>{tick.label}</span>)}
    <span class="dot" style={`left: 100%; top: ${y(solves.length)}%`}></span>
    <span class="end" style={`top: ${y(solves.length)}%`}>{solves.length}</span>
    <div class="crosshair" hidden></div>
    <div class="tip" hidden><strong></strong><span></span></div>
  </div>
</figure>

<script>
  for (const plot of document.querySelectorAll<HTMLElement>('.chart .plot')) {
    const points: [number, number, number][] = JSON.parse(plot.dataset.points!);
    const t0 = Number(plot.dataset.t0);
    const t1 = Number(plot.dataset.t1);
    const yMax = Number(plot.dataset.ymax);
    const cross = plot.querySelector<HTMLElement>('.crosshair')!;
    const tip = plot.querySelector<HTMLElement>('.tip')!;
    const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    let current = points.length - 1;

    const show = (i: number) => {
      current = i;
      const [t, n, id] = points[i];
      const left = ((t - t0) / (t1 - t0)) * 100;
      cross.style.left = `${left}%`;
      cross.hidden = tip.hidden = false;
      tip.querySelector('strong')!.textContent = `${n} solved`;
      tip.querySelector('span')!.textContent = `#${id} · ${fmt.format(t)}`;
      tip.style.left = `${left}%`;
      tip.style.top = `${100 - (n / yMax) * 100}%`;
      tip.classList.toggle('flip', left > 65);
    };
    const hide = () => (cross.hidden = tip.hidden = true);

    // Nearest solve to the pointer, by time.
    plot.addEventListener('pointermove', e => {
      const box = plot.getBoundingClientRect();
      const t = t0 + ((e.clientX - box.left) / box.width) * (t1 - t0);
      let lo = 0, hi = points.length - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (points[mid][0] < t) lo = mid + 1;
        else hi = mid;
      }
      const i = lo > 0 && t - points[lo - 1][0] < points[lo][0] - t ? lo - 1 : lo;
      show(i);
    });
    plot.addEventListener('pointerleave', hide);
    plot.addEventListener('focus', () => show(current));
    plot.addEventListener('blur', hide);
    plot.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') show(Math.max(0, current - 1));
      else if (e.key === 'ArrowRight') show(Math.min(points.length - 1, current + 1));
      else return;
      e.preventDefault();
    });
  }
</script>

<style>
  .chart {
    margin: 0;
  }
  figcaption {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--heading);
  }
  .plot {
    position: relative;
    height: 11rem;
    margin: 0 2.5rem 1.75rem 2rem;
    outline-offset: 6px;
    cursor: crosshair;
    touch-action: pan-y;
  }
  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .grid {
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .area {
    fill: var(--chart);
    opacity: 0.1;
  }
  .line {
    fill: none;
    stroke: var(--chart);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .ytick,
  .xtick,
  .end {
    position: absolute;
    font-size: 0.72rem;
    line-height: 1;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .ytick {
    right: calc(100% + 0.6rem);
    transform: translateY(-50%);
  }
  .xtick {
    top: calc(100% + 0.6rem);
    transform: translateX(-50%);
  }
  .end {
    left: calc(100% + 0.7rem);
    transform: translateY(-50%);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--heading);
  }
  .dot {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--chart);
    transform: translate(-50%, -50%);
  }
  .crosshair {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-strong);
    pointer-events: none;
  }
  .tip {
    position: absolute;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: var(--shadow);
    font-size: 0.78rem;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(0.75rem, -110%);
  }
  .tip.flip {
    transform: translate(calc(-100% - 0.75rem), -110%);
  }
  .tip strong {
    font-size: 0.85rem;
    color: var(--heading);
  }
  .tip span {
    color: var(--muted);
  }
  [hidden] {
    display: none !important;
  }
</style>
