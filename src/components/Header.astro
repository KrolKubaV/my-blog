---
import { NAV } from '../config';
import Search from './Search.astro';
---
<header>
  <nav>
    <a href="/" class="site-name">Jakub Adamek</a>
    <div class="right">
      <div class="nav-links">
        {NAV.slice(1).map((item, i) => (
          <>
            <a href={item.href}>{item.label}</a>
            {i < NAV.length - 2 && <span class="dot">·</span>}
          </>
        ))}
      </div>
      <div class="controls">
        <Search />
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">◐</button>
      </div>
    </div>
  </nav>
</header>

<style>
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.95rem;
    gap: 1rem;
  }
  .site-name {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent);
    font-size: 1.15rem;
  }
  .right {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .nav-links {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .nav-links a {
    transition: color 0.15s;
  }
  .nav-links a:hover {
    text-decoration: underline;
  }
  .dot {
    color: var(--color-muted);
    user-select: none;
  }
</style>
