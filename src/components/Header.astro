---
import { NAV } from '../config';
---
<header>
  <nav>
    <a href="/" style="font-weight: 700; text-decoration: none;">Jakub Adamek</a>
    <span style="margin: 0 0.5rem; color: var(--color-border);">·</span>
    {NAV.slice(1).map((item, i) => (
      <>
        <a href={item.href}>{item.label}</a>
        {i < NAV.length - 2 && <span style="margin: 0 0.5rem; color: var(--color-border);">·</span>}
      </>
    ))}
  </nav>
</header>

<style>
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  nav {
    font-size: 0.95rem;
  }
</style>
