---
import { NAV } from '../config';
---
<header>
  <nav>
    <a href="/my-blog/" class="site-name">Jakub Adamek</a>
    <div class="nav-links">
      {NAV.slice(1).map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.95rem;
  }
  .site-name {
    font-weight: 700;
    text-decoration: none;
    color: #2563eb;
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
  }
</style>
