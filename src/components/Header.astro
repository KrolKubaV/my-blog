---
import { NAV } from '../config';
---
<header>
  <nav>
    <a href="/" class="site-name">Jakub Adamek</a>
    <span class="dot">·</span>
    {NAV.slice(1).map((item, i) => (
      <>
        <a href={item.href}>{item.label}</a>
        {i < NAV.length - 2 && <span class="dot">·</span>}
      </>
    ))}
  </nav>
</header>

<style>
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }
  nav {
    font-size: 0.95rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0;
  }
  nav a {
    display: inline;
  }
  .site-name {
    font-weight: 700;
    text-decoration: none;
    color: #2563eb;
  }
  .dot {
    margin: 0 0.5rem;
    color: #9ca3af;
  }
</style>
