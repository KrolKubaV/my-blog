---
import { NAV } from '../config';
---
<header>
  <nav>
    <a href="/my-blog/" class="site-name">Jakub Adamek</a>
    <div class="nav-links">
      {NAV.slice(1).map((item, i) => (
        <>
          <a href={item.href}>{item.label}</a>
          {i < NAV.length - 2 && <span class="dot">·</span>}
        </>
      ))}
    </div>
  </nav>
</header>

<style>
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.95rem;
  }
  .site-name {
    font-weight: 700;
    text-decoration: none;
    color: #1e3a5f;
    font-size: 1.15rem;
  }
  .nav-links {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .nav-links a {
    transition: color 0.15s;
  }
  .nav-links a:hover {
    text-decoration: underline;
  }
  .dot {
    color: #9ca3af;
    user-select: none;
  }
</style>
