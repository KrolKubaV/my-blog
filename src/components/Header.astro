---
import { NAV, SITE } from '../config';

interface Props {
  wide?: boolean; // match the wider notes layout
}

const { wide = false } = Astro.props;
const path = Astro.url.pathname;
---
<header>
  <div class:list={['page', 'bar', { wide }]}>
    <a href="/" class="brand">{SITE.title}</a>
    <div class="right">
      <nav aria-label="Main">
        {NAV.map(item => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <button class="theme" type="button" aria-label="Switch between light and dark mode" title="Light / dark">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelector('header .theme')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    min-height: 4.25rem;
    padding-block: 0.75rem;
  }
  .brand {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--heading);
  }
  .brand:hover {
    color: var(--heading);
    opacity: 0.75;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: -0.4rem;
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .theme:hover {
    color: var(--heading);
    background: var(--surface);
  }
  .theme svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: block;
  }
  nav a {
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    font-size: 1rem;
    color: var(--muted);
    transition: color 0.15s, background 0.15s;
  }
  nav a:hover {
    color: var(--heading);
    background: var(--surface);
  }
  nav a[aria-current='page'] {
    color: var(--heading);
    background: var(--surface-2);
  }
  @media (max-width: 30rem) {
    .right {
      width: 100%;
      justify-content: space-between;
      margin-left: -0.65rem;
    }
  }
</style>
