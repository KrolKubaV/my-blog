---
import { LINKS, SITE } from '../config';
---
<footer>
  <div class="page bar">
    <span>© {new Date().getFullYear()} {SITE.author}</span>
    <nav aria-label="Elsewhere">
      {LINKS.map(link => <a href={link.href}>{link.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--faint);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.75rem;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--heading);
  }
</style>
