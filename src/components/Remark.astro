---
interface Props {
  title?: string;
}

const { title }: { title?: string } = Astro.props;
---
<div class="box remark">
  <div class="box-title">{title ?? 'Remark'}</div>
  <div class="box-content">
    <slot />
  </div>
</div>

<style>
  .box {
    border-radius: 4px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-left: 4px solid;
  }
  .remark {
    background: #fef2f2;
    border-color: #ef4444;
  }
  .box-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
    font-style: italic;
  }
  .remark .box-title {
    color: #991b1b;
  }
  .box :global(*) {
    margin-top: 0;
  }
</style>
