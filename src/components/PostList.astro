---
import { SHOW } from '../config';
import { postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showTags?: boolean;
}

const { posts, showTags = false } = Astro.props;
---
<ul class="post-list">
  {posts.map(post => (
    <li>
      <a href={postUrl(post)} class="post-link">
        <span class="title">{post.data.title}</span>
        {post.data.draft && <span class="badge draft">Draft</span>}
        {SHOW.postDescriptions && post.data.description && <span class="desc">{post.data.description}</span>}
        {showTags && post.data.tags.length > 0 && (
          <span class="tags">{post.data.tags.map(t => <span class="tag">{t}</span>)}</span>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .badge {
    margin-left: 0.5rem;
    vertical-align: 0.15em;
  }
</style>
