---
// Table of contents for a note topic, always within reach:
// a sticky sidebar on wide screens, a sticky "Contents" bar on narrow ones.
import type { MarkdownHeading } from 'astro';
import NoteChapters from './NoteChapters.astro';
import type { Topic } from '../lib/posts';

interface Props {
  topic: Topic;
  currentId: string;
  headings: MarkdownHeading[];
}

const { topic } = Astro.props;
---
<details class="contents-bar">
  <summary>
    <span class="bar-topic">{topic.label}</span>
    <span class="bar-hint">Contents</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <div class="bar-body">
    <NoteChapters {...Astro.props} />
    <a class="all" href="/notes/">← All topics</a>
  </div>
</details>

<nav class="sidebar" aria-label={`Contents of ${topic.label}`}>
  <a class="all" href="/notes/">← All topics</a>
  <p class="topic">{topic.label}</p>
  <NoteChapters {...Astro.props} />
</nav>

<script>
  import { scrollSpy } from '../lib/scroll-spy';

  scrollSpy([...document.querySelectorAll<HTMLAnchorElement>('.sections a')]);
  // Close the phone bar after a jump.
  const bar = document.querySelector<HTMLDetailsElement>('.contents-bar');
  bar?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => (bar.open = false)));
</script>

<style>
  .all {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .all:hover {
    color: var(--accent);
  }

  /* ----- Wide screens: sticky sidebar ----- */
  .sidebar {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    font-size: 0.95rem;
  }
  .topic {
    margin: 0.9rem 0 0.6rem 0.6rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--heading);
  }

  /* ----- Narrow screens: sticky "Contents" bar ----- */
  .contents-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: -1.5rem -1.5rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .contents-bar summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.5rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .contents-bar summary::-webkit-details-marker {
    display: none;
  }
  .bar-topic {
    font-weight: 700;
    color: var(--heading);
  }
  .bar-hint {
    margin-left: auto;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .contents-bar svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--muted);
    transition: transform 0.2s;
  }
  .contents-bar[open] svg {
    transform: rotate(180deg);
  }
  .bar-body {
    max-height: 70vh;
    overflow-y: auto;
    padding: 0 1rem 1rem;
  }
  .bar-body .all {
    margin: 0.75rem 0 0 0.6rem;
  }

  @media (min-width: 68rem) {
    .contents-bar {
      display: none;
    }
  }
  @media (max-width: 67.99rem) {
    .sidebar {
      display: none;
    }
    /* Jumping to a section stops below the sticky bar, not under it. */
    :global(html:has(.contents-bar)) {
      scroll-padding-top: 4.5rem;
    }
  }
</style>
