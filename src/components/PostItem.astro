---
interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
---
<li class="post-item">
  <a href={slug}>
    <span class="post-title">{title}</span>
  </a>
</li>

<style>
  .post-item {
    list-style: none;
    margin-top: 0;
    border-bottom: 1px solid #f3f4f6;
  }
  .post-item:last-child {
    border-bottom: none;
  }
  .post-item a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.85rem 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.2s ease;
  }
  .post-item a:hover {
    padding-left: 0.4rem;
    text-decoration: none;
  }
  .post-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: #111827;
    transition: color 0.2s;
  }
  .post-item a:hover .post-title {
    color: #1e3a5f;
  }
</style>
