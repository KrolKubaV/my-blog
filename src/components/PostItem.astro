---
interface Props {
  title: string;
  slug: string;
  description?: string;
}

const { title, slug, description } = Astro.props;
---
<li class="post-item">
  <a href={slug}>
    <span class="post-title">{title}</span>
    {description && <span class="post-desc">{description}</span>}
  </a>
</li>

<style>
  .post-item {
    list-style: none;
    margin-top: 0;
  }
  .post-item a {
    display: block;
    padding: 0.75rem 1rem;
    margin: 0 -1rem;
    border-radius: 6px;
    transition: background 0.15s;
    text-decoration: none;
    color: inherit;
  }
  .post-item a:hover {
    background: #f9fafb;
    text-decoration: none;
  }
  .post-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: #111827;
  }
  .post-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: #6b7280;
  }
  .post-item a:hover .post-title {
    color: #1e3a5f;
  }
</style>
